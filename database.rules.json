{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('nick').isString() && newData.child('nick').val().length <= 40 && newData.child('av').isString() && newData.child('av').val().length <= 8"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friend": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friend)"
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "quick": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || !data.child('guest').exists())"
      }
    },
    "leader": {
      "$week": {
        ".read": "auth != null",
        ".indexOn": [
          "wins"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "houses": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('f').isNumber() && newData.child('i').isString() && newData.child('i').val().length <= 400 && newData.child('n').isString() && newData.child('n').val().length <= 40"
      }
    },
    "gifts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('f').val() === auth.uid && root.child('friends/' + $uid + '/' + auth.uid).exists()) || (auth.uid === $uid && !newData.exists()))",
          ".validate": "newData.child('g').isString() && newData.child('g').val().length <= 16 && newData.child('n').isString() && newData.child('n').val().length <= 40"
        }
      }
    },
    "hlikes": {
      "$uid": {
        ".read": "auth != null",
        "$from": {
          ".write": "auth != null && auth.uid === $from && root.child('friends/' + $uid + '/' + $from).exists()",
          ".validate": "newData.child('n').isNumber() && newData.child('n').val() <= (data.exists() ? data.child('n').val() : 0) + 1"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "news": {
      ".read": "auth != null",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
        ".validate": "!newData.exists() || (newData.child('msg').isString() && newData.child('msg').val().length <= 600 && newData.child('title').isString() && newData.child('title').val().length <= 60 && newData.child('j').isNumber() && newData.child('j').val() <= 500)"
      }
    },
    "prizes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && (root.child('admins/' + auth.uid).val() === true || (auth.uid === $uid && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.child('msg').isString() && newData.child('msg').val().length <= 400 && newData.child('j').isNumber() && newData.child('j').val() <= 1000)"
        }
      }
    },
    "hvisit": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && auth.uid === $from && root.child('friends/' + $uid + '/' + $from).exists()",
          ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 40"
        }
      }
    }
  }
}